generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum StockMovementType {
  RESTOCK
  ADJUSTMENT
  RESERVE
  COMMIT
  RELEASE
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPING
  DELIVERED
  CANCELLED
  PAYMENT_EXPIRED
}

enum PaymentMethod {
  COD
  VNPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum PaymentTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

model User {
  id                   String               @id @default(uuid()) @db.Uuid
  email                String               @unique @db.VarChar(255)
  passwordHash         String               @map("password_hash") @db.VarChar(255)
  fullName             String               @map("full_name") @db.VarChar(100)
  avatarUrl            String?              @map("avatar_url") @db.VarChar(500)
  role                 Role                 @default(CUSTOMER)
  isActive             Boolean              @default(true) @map("is_active")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  refreshTokens        RefreshToken[]
  addresses            Address[]
  permissions          UserPermission[]
  auditLogs            AuditLog[]
  stockMovements       StockMovement[]
  cart                 Cart?
  couponUsages         CouponUsage[]
  orders               Order[]
  orderStatusHistories OrderStatusHistory[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  familyId  String   @map("family_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  isRevoked Boolean  @default(false) @map("is_revoked")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Address {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  recipientName String   @map("recipient_name") @db.VarChar(100)
  phone         String   @db.VarChar(20)
  province      String   @db.VarChar(100)
  district      String   @db.VarChar(100)
  ward          String   @db.VarChar(100)
  streetAddress String   @map("street_address") @db.VarChar(255)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model UserPermission {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  permission String   @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
  @@map("user_permissions")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  targetType String   @map("target_type") @db.VarChar(50)
  targetId   String?  @map("target_id") @db.VarChar(255)
  payload    Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @db.VarChar(100)
  slug        String     @unique @db.VarChar(100)
  description String?    @db.Text
  parentId    String?    @map("parent_id") @db.Uuid
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  description String?   @db.Text
  logoUrl     String?   @map("logo_url") @db.VarChar(500)
  products    Product[]
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("brands")
}

model Product {
  id             String                 @id @default(uuid()) @db.Uuid
  name           String                 @db.VarChar(255)
  slug           String                 @unique @db.VarChar(255)
  description    String?                @db.Text
  status         ProductStatus          @default(DRAFT)
  categoryId     String                 @map("category_id") @db.Uuid
  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId        String?                @map("brand_id") @db.Uuid
  brand          Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images         ProductImage[]
  variants       ProductVariant[]
  specifications ProductSpecification[]
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  url          String   @db.VarChar(500)
  isThumbnail  Boolean  @default(false) @map("is_thumbnail")
  displayOrder Int      @default(0) @map("display_order")
  altText      String?  @map("alt_text") @db.VarChar(255)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id             String      @id @default(uuid()) @db.Uuid
  productId      String      @map("product_id") @db.Uuid
  sku            String      @unique @db.VarChar(100)
  name           String      @db.VarChar(150)
  price          BigInt      @db.BigInt
  compareAtPrice BigInt?     @map("compare_at_price") @db.BigInt
  options        Json?       @db.JsonB
  isActive       Boolean     @default(true) @map("is_active")
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory      Inventory?
  cartItems      CartItem[]
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([productId])
  @@index([price])
  @@index([isActive])
  @@map("product_variants")
}

model ProductSpecification {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  name         String   @db.VarChar(100)
  value        String   @db.VarChar(255)
  displayOrder Int      @default(0) @map("display_order")
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_specifications")
}

model Inventory {
  id        String          @id @default(uuid()) @db.Uuid
  variantId String          @unique @map("variant_id") @db.Uuid
  onHand    Int             @default(0) @map("on_hand")
  reserved  Int             @default(0)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  @@map("inventories")
}

model StockMovement {
  id                   String            @id @default(uuid()) @db.Uuid
  inventoryId          String            @map("inventory_id") @db.Uuid
  type                 StockMovementType
  onHandChange         Int               @default(0) @map("on_hand_change")
  reservedChange       Int               @default(0) @map("reserved_change")
  balanceAfterOnHand   Int               @map("balance_after_on_hand")
  balanceAfterReserved Int               @map("balance_after_reserved")
  reason               String?           @db.VarChar(255)
  referenceType        String?           @map("reference_type") @db.VarChar(50)
  referenceId          String?           @map("reference_id") @db.VarChar(255)
  actorId              String?           @map("actor_id") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  inventory            Inventory         @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  actor                User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([inventoryId])
  @@index([actorId])
  @@unique([inventoryId, type, referenceType, referenceId])
  @@map("stock_movements")
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @map("user_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @map("cart_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  quantity  Int            @default(1)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
  @@map("cart_items")
}

model Coupon {
  id                String        @id @default(uuid()) @db.Uuid
  code              String        @unique @db.VarChar(50)
  description       String?       @db.Text
  discountType      DiscountType  @map("discount_type")
  discountValue     BigInt        @map("discount_value") @db.BigInt
  maxDiscountAmount BigInt?       @map("max_discount_amount") @db.BigInt
  minOrderAmount    BigInt        @default(0) @map("min_order_amount") @db.BigInt
  usageLimit        Int?          @map("usage_limit")
  usedCount         Int           @default(0) @map("used_count")
  usageLimitPerUser Int?          @default(1) @map("usage_limit_per_user")
  startDate         DateTime      @map("start_date") @db.Timestamptz(3)
  endDate           DateTime      @map("end_date") @db.Timestamptz(3)
  isActive          Boolean       @default(true) @map("is_active")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  usages            CouponUsage[]

  @@index([code])
  @@index([isActive])
  @@map("coupons")
}

model CouponUsage {
  id             String   @id @default(uuid()) @db.Uuid
  couponId       String   @map("coupon_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  orderId        String?  @map("order_id") @db.Uuid
  discountAmount BigInt   @map("discount_amount") @db.BigInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([couponId, userId])
  @@index([userId])
  @@index([orderId])
  @@map("coupon_usages")
}

model Order {
  id             String               @id @default(uuid()) @db.Uuid
  orderNumber    String               @unique @map("order_number") @db.VarChar(50)
  userId         String               @map("user_id") @db.Uuid
  status         OrderStatus          @default(PENDING_PAYMENT)
  paymentMethod  PaymentMethod        @map("payment_method")
  paymentStatus  PaymentStatus        @default(PENDING) @map("payment_status")
  subtotalAmount BigInt               @map("subtotal_amount") @db.BigInt
  discountAmount BigInt               @default(0) @map("discount_amount") @db.BigInt
  shippingFee    BigInt               @default(0) @map("shipping_fee") @db.BigInt
  totalAmount    BigInt               @map("total_amount") @db.BigInt
  recipientName  String               @map("recipient_name") @db.VarChar(100)
  phone          String               @db.VarChar(20)
  province       String               @db.VarChar(100)
  district       String               @db.VarChar(100)
  ward           String               @db.VarChar(100)
  streetAddress  String               @map("street_address") @db.VarChar(255)
  couponCode     String?              @map("coupon_code") @db.VarChar(50)
  notes          String?              @db.Text
  cancelReason   String?              @map("cancel_reason") @db.VarChar(255)
  cancelledAt    DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  paymentExpiresAt DateTime?          @map("payment_expires_at") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  couponUsages        CouponUsage[]
  paymentTransactions PaymentTransaction[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentExpiresAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String          @id @default(uuid()) @db.Uuid
  orderId     String          @map("order_id") @db.Uuid
  variantId   String?         @map("variant_id") @db.Uuid
  productName String          @map("product_name") @db.VarChar(255)
  sku         String          @db.VarChar(100)
  options     Json?           @db.JsonB
  unitPrice   BigInt          @map("unit_price") @db.BigInt
  quantity    Int
  totalPrice  BigInt          @map("total_price") @db.BigInt
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  reason      String?      @db.VarChar(255)
  changedById String?      @map("changed_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy   User?        @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([changedById])
  @@map("order_status_history")
}

model PaymentTransaction {
  id                String                   @id @default(uuid()) @db.Uuid
  orderId           String                   @map("order_id") @db.Uuid
  paymentMethod     PaymentMethod            @default(VNPAY) @map("payment_method")
  txnRef            String                   @unique @map("txn_ref") @db.VarChar(100)
  bankCode          String?                  @map("bank_code") @db.VarChar(50)
  bankTranNo        String?                  @map("bank_tran_no") @db.VarChar(255)
  cardType          String?                  @map("card_type") @db.VarChar(50)
  amount            BigInt                   @db.BigInt
  status            PaymentTransactionStatus @default(PENDING)
  responseCode      String?                  @map("response_code") @db.VarChar(50)
  transactionNo     String?                  @map("transaction_no") @db.VarChar(100)
  transactionStatus String?                  @map("transaction_status") @db.VarChar(50)
  payDate           DateTime?                @map("pay_date") @db.Timestamptz(3)
  metadata          Json?                    @db.JsonB
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  order             Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([txnRef])
  @@index([status])
  @@map("payment_transactions")
}
