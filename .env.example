NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DATABASE_URL=postgresql://ecommerce:ecommerce@127.0.0.1:5432/ecommerce?schema=public
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-access
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters-refresh

# Caddy Reverse Proxy & Domain (Production)
DOMAIN_NAME=:80

# Admin Seed Credentials
ADMIN_EMAIL=admin@ecommerce.local
ADMIN_PASSWORD=change_this_to_a_secure_admin_password_123
ADMIN_FULLNAME="System Administrator"

# AWS S3 Storage & Uploads
# Configure an S3 lifecycle rule to expire temp/ objects after 1 day.
AWS_REGION=ap-southeast-1
# Local development only. In production, omit both keys and use the EC2 IAM role.
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=ecommerce-assets
# AWS_S3_ENDPOINT=http://127.0.0.1:9000
# AWS_S3_PUBLIC_DOMAIN=https://cdn.example.com
